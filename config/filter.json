{
  "说明": "手机壳找款筛选规则（v2：明显图案特征 + 支付买家数分档）。想改口径只改这个文件，改完重跑 tools/filter-feilin.mjs。",
  "硬条件": {
    "支付买家数最少": 1,
    "备注": "用户口径：当天有支付买家数。榜单『支付买家数』列是精确数字（访客数才是区间）。"
  },
  "支付买家数分档": [
    { "档": "第一优先", "最小": 100, "最大": 250, "原始档": "100 ~ 250", "说明": "用户点名：卖得动又没到饱和大店" },
    { "档": "第二优先", "最小": 50,  "最大": 99,  "原始档": "50 ~ 100",  "说明": "用户点名优先" },
    { "档": "第三优先", "最小": 10,  "最大": 49,  "原始档": "10 ~ 50",   "说明": "其次" },
    { "档": "备选",     "最小": 0,   "最大": 9,   "原始档": "0 ~ 10",    "说明": "这个区间档里可能含当天 0 支付的，默认不混进前三档（加 --with-备选 才出）" }
  ],
  "图案特征": {
    "说明": "菲林壳要的是能印的图案。标题只能『排掉明显不是图案的』，靠不靠得住要看主图——所以本工具会给每条打图案信号，方便下一步看图确认。",
    "图案词": [
      "波点", "格纹", "格子", "条纹", "碎花", "花朵", "花", "卡通", "插画", "手绘",
      "涂鸦", "油画", "水彩", "渐变", "大理石", "星空", "蝴蝶", "草莓", "爱心", "豹纹",
      "字母", "笑脸", "云朵", "猫", "兔", "狗", "水果", "植物", "风景", "人物", "图案", "印花", "贴图"
    ],
    "排除词": [
      "纯色", "液态", "全透明", "无色", "素壳", "无图案", "裸机感", "磨砂纯色", "透明软壳"
    ],
    "必须命中图案词": false
  },
  "菲林壳适配": {
    "说明": "非平面/工艺类先排掉。",
    "排除词": ["毛绒", "皮革", "翻盖", "钱包", "支架一体", "带挂绳", "指环扣", "卡包", "钥匙扣", "气囊"]
  }
}
